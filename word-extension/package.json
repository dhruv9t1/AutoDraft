{
  "name": "autodraft-word-addin",
  "version": "1.3.0",
  "license": "MIT",
  "config": {
    "app_to_debug": "word",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "scripts": {
    "build": "node scripts/build.js",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "logger-server": "node src/services/logger-server.js",
    "lint": "office-addin-lint check",
    "lint:fix": "office-addin-lint fix",
    "prettier": "office-addin-lint prettier",
    "signin": "office-addin-dev-settings m365-account login",
    "signout": "office-addin-dev-settings m365-account logout",
    "start": "office-addin-debugging start manifest.xml",
    "stop": "office-addin-debugging stop manifest.xml",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "validate": "office-addin-manifest validate manifest.xml",
    "verify": "node scripts/verify.js full",
    "verify:quick": "node scripts/verify.js quick",
    "verify:build": "node scripts/verify.js build",
    "watch": "webpack --mode development --watch",
    "render:production-manifest": "python ../scripts/render-production-manifest.py",
    "validate:production-manifest": "office-addin-manifest validate manifest.production.xml",
    "prestart": "node scripts/prepare-debug-start.js"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.55.1",
    "@fluentui/react-icons": "^2.0.264",
    "@types/pako": "^2.0.4",
    "core-js": "^3.36.0",
    "es6-promise": "^4.2.8",
    "pako": "^2.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-typescript": "^7.23.3",
    "@types/office-js": "^1.0.377",
    "@types/office-runtime": "^1.0.35",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/webpack": "^5.28.5",
    "@typescript-eslint/eslint-plugin": "8.8.1",
    "@typescript-eslint/parser": "8.8.1",
    "@vitest/ui": "^4.1.5",
    "acorn": "^8.11.3",
    "ajv": "^8.17.1",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "14.0.0",
    "eslint-plugin-office-addins": "^4.0.3",
    "eslint-plugin-react": "^7.28.0",
    "file-loader": "^6.2.0",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.6.0",
    "jsdom": "^29.1.1",
    "less": "^4.2.0",
    "less-loader": "^12.2.0",
    "office-addin-cli": "^2.0.3",
    "office-addin-debugging": "7.0.1",
    "office-addin-dev-certs": "^2.0.3",
    "office-addin-lint": "^3.0.3",
    "office-addin-manifest": "3.0.1",
    "office-addin-prettier-config": "^2.0.1",
    "os-browserify": "^0.3.0",
    "process": "^0.11.10",
    "source-map-loader": "^5.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.2",
    "vitest": "^4.1.5",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "5.2.6"
  },
  "prettier": "office-addin-prettier-config",
  "browserslist": [
    "last 2 versions"
  ],
  "sideEffects": false
}
