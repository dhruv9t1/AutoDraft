# Database
# Runtime DB role: must be non-owner, non-superuser, NOBYPASSRLS.
DATABASE_URL=postgresql://autodraft_app:CHANGE_ME@localhost:5432/wordaddin
# Recommended in production: separate owner/migrator credentials used only for DDL.
MIGRATION_DATABASE_URL=
# Local-development escape hatch only. Keep false in production.
ALLOW_UNSAFE_DATABASE_ROLE=false
# Historical default tenant is available only when SECURITY_MODE=local.
ALLOW_LOCAL_DEFAULT_ORGANIZATION=true
# Development-only escape hatch. Never enable on an internet-facing deployment.
ALLOW_EXTERNAL_LOCAL_AUTH=false

# Server
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=INFO

# API protection / browser origins
# local = explicit single-user development mode; token = multi-user/production tenant mode
SECURITY_MODE=local
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_HMAC_SECRET=
# Production Word add-in identity / Office SSO. The Entra app must expose access_as_user.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_RESOURCE_URI=
ENTRA_REQUIRED_SCOPE=access_as_user
AUTH_TOKEN_TTL_SECONDS=3600
# Ollama
OLLAMA_API_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=
OLLAMA_API_PATH=/api/chat
OLLAMA_MODEL=qwen3:4b
FIELD_MODEL=qwen3:4b
DRAFTING_MODEL=qwen3:4b
REVIEW_MODEL=qwen3:4b
OLLAMA_VERIFIER_MODEL=qwen3:4b
OLLAMA_ENABLE_FIELD_VERIFIER=true
OLLAMA_VALIDATE_ON_STARTUP=true
OLLAMA_REQUIRE_MODEL_ON_STARTUP=false
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_MAX_RETRIES=2
OLLAMA_CHUNK_SIZE=8000
OLLAMA_MAX_PARALLEL_CHUNKS=2
# 1 = one extraction pass per chunk; 2 intentionally adds a coverage pass.
OLLAMA_EXTRACTION_PASSES=2
OLLAMA_THINK_LEVEL=off
OLLAMA_TEMPERATURE=0.0
OLLAMA_TOP_P=1.0
OLLAMA_TOP_K=1
OLLAMA_SEED=42


# Optional System-1 candidate decider (lawyer-firm/Jev architecture)
# Keep off unless you intentionally configure the hosted Jev provider.
SYSTEM1_PROVIDER=off
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=20

# Resilient job/SSE transport
SSE_HEARTBEAT_SECONDS=10
EXTRACTION_JOB_TTL_SECONDS=3600


# Durable runtime queue / object storage
# In production/token mode API processes do not execute OCR/extraction jobs; run:
#   python -m app.runtime_worker_process
RUNTIME_WORKER_MODE=auto
RUNTIME_WORKER_CONCURRENCY=2
RUNTIME_CLUSTER_CONCURRENCY=4
RUNTIME_WORKER_LEASE_SECONDS=90
RUNTIME_MAX_ACTIVE_JOBS_PER_ORG=8
RUNTIME_MAX_ACTIVE_JOBS_PER_USER=4
RUNTIME_MAX_CHUNK_SESSIONS_PER_USER=4
RUNTIME_MAX_TEMP_BYTES_PER_ORG=536870912
# Point this at durable shared storage visible to every API/worker instance.
RUNTIME_OBJECT_STORE_PATH=.runtime-objects
CHUNK_SESSION_TTL_SECONDS=3600

# Local OCR (OS prerequisites: OCRmyPDF + Tesseract guj/eng language data)
OCR_LANGUAGES=guj,eng
OCR_TIMEOUT_SECONDS=1800
OCR_JOB_TTL_SECONDS=3600
OCR_MAX_UPLOAD_BYTES=52428800
OCR_MAX_IMAGE_WIDTH=12000
OCR_MAX_IMAGE_HEIGHT=12000
OCR_MAX_IMAGE_PIXELS_PER_FRAME=40000000
OCR_MAX_IMAGE_FRAMES=50
OCR_MAX_IMAGE_TOTAL_PIXELS=100000000
OCR_MAX_PDF_PAGES=500
OCR_MAX_PDF_PAGE_WIDTH_POINTS=2160
OCR_MAX_PDF_PAGE_HEIGHT_POINTS=2160
OCR_MAX_PDF_PAGE_AREA_POINTS=2000000
OCR_MAX_OUTPUT_PDF_BYTES=209715200
OCR_MAX_EXTRACTED_TEXT_CHARS=10000000
OCR_SUBPROCESS_MAX_MEMORY_BYTES=2147483648
OCR_SUBPROCESS_MAX_CPU_SECONDS=1200
OCR_SUBPROCESS_MAX_FILE_BYTES=536870912
OCR_MAX_TEMP_BYTES=1073741824
OCR_SMOKE_CACHE_SECONDS=300

# Limits
MAX_REQUEST_BODY_BYTES=167772160
MAX_PUBLIC_REQUEST_BODY_BYTES=2097152
MAX_RENDERED_DOCX_BYTES=157286400
MAX_RENDERED_XML_PART_BYTES=67108864
MAX_RENDERED_TOTAL_XML_BYTES=100663296
MAX_RENDERED_UNCOMPRESSED_DOCX_BYTES=251658240
MAX_RENDERED_CONTENT_CONTROLS=20000
MAX_REPEATER_ITEMS=250
MAX_TOTAL_REPEATED_ITEMS=2000
MAX_DOCUMENT_LENGTH=5242880
MAX_OOXML_BODY_BYTES=52428800

# Production authorization/browser/rate-limit hardening
# Required for cross-origin Word add-in access in SECURITY_MODE=token; empty fails closed.
CORS_ORIGINS=
# Trust X-Forwarded-For/X-Real-IP only from these proxy IPs/CIDRs.
TRUSTED_PROXY_IPS=
RATE_LIMIT_REQUESTS=180
RATE_LIMIT_WINDOW_SECONDS=60
# Number of shared permits reserved per database operation; lower is fairer, higher reduces DB writes.
RATE_LIMIT_LEASE_SIZE=10
# Bounded per-process emergency ceiling used only while PostgreSQL rate-limit storage is unavailable.
RATE_LIMIT_FALLBACK_REQUESTS=45
RATE_LIMIT_DB_RETRY_SECONDS=5
SECURITY_ENABLE_HSTS=true
SECURITY_HSTS_SECONDS=31536000
SECURITY_FRAME_ANCESTORS="'self' https://*.office.com https://*.officeapps.live.com"

# Application binary storage / queued authoritative generation
# Point at durable shared storage in production (or replace BinaryObjectStore with S3/Azure/GCS backend).
BINARY_OBJECT_STORE_PATH=.binary-objects
# Required in SECURITY_MODE=token. Generate 32 random bytes, e.g.:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
OBJECT_STORE_ENCRYPTION_KEY=
GENERATION_JOB_TTL_SECONDS=86400
# JSON is deliberately much smaller than the binary upload ceiling so large Base64 JSON is rejected before parsing.
MAX_JSON_REQUEST_BODY_BYTES=16777216
MAX_BINARY_UPLOAD_BODY_BYTES=115343360

# Webhook delivery worker (required only when webhook endpoints are configured)
WEBHOOK_SECRET_ENCRYPTION_KEY=
WEBHOOK_WORKER_POLL_SECONDS=0.5
WEBHOOK_WORKER_CONCURRENCY=4
WEBHOOK_LEASE_SECONDS=60
WEBHOOK_TIMEOUT_SECONDS=15
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_BACKOFF_BASE_SECONDS=5
WEBHOOK_BACKOFF_MAX_SECONDS=3600
WEBHOOK_PREPARE_BATCH_SIZE=100
WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# Public intake quarantine: rejected uploads have separate bounded capacity and expire.
INTAKE_QUARANTINE_RETENTION_SECONDS=86400
INTAKE_QUARANTINE_CLEANUP_INTERVAL_SECONDS=3600
INTAKE_QUARANTINE_SESSION_STORAGE_QUOTA_BYTES=26214400
INTAKE_QUARANTINE_SESSION_FILE_COUNT_LIMIT=20
INTAKE_QUARANTINE_ORG_DAILY_UPLOAD_QUOTA_BYTES=262144000
